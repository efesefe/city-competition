# Application
APP_ENV=development
HTTP_ADDR=:8080

# PostgreSQL (used by backend; compose service hostname is "postgres")
DATABASE_URL=postgres://citycomp:citycomp@postgres:5432/citycomp?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m

# Redis
REDIS_URL=redis://redis:6379/0

# Social login (Google / Apple ID token audiences). Optional in development.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Tribe switch cooldown (Go duration). Default 7 days.
TRIBE_SWITCH_COOLDOWN=168h

# Credits stub top-up (local/dev/QA only; refused in production and when false).
CREDITS_STUB_ENABLED=true
CREDITS_STUB_GRANT_AMOUNT=100

# Per-user Redis token-bucket rate limits (tokens/sec + burst capacity).
RATE_LIMIT_SUPPORT_RATE=2
RATE_LIMIT_SUPPORT_BURST=5
RATE_LIMIT_CREDIT_WRITE_RATE=1
RATE_LIMIT_CREDIT_WRITE_BURST=3

# Materialize province_control_summary from tribe_province_scores on this interval
# (not on each spend). Choropleth reads the summary table only. Default 30s.
PROVINCE_CONTROL_REFRESH_INTERVAL=30s

# Lead-threatened alerts: second place within this relative gap of the leader
# ((leader-second)/leader) triggers a rate-limited notif_queue enqueue.
LEAD_THREATENED_GAP_RATIO=0.10
LEAD_THREATENED_RATE_LIMIT=30m

# Derby state machine ticker and Redis score TTL after resolve (crash-safe retry).
DERBY_SCHEDULER_INTERVAL=5s
DERBY_SCORE_TTL=24h

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
# Data residency disclosure (TR or EU) — used by DataResidencyBanner
NEXT_PUBLIC_DATA_REGION=TR
# Optional stub ID token for local/e2e social login (never used in production builds)
# NEXT_PUBLIC_SOCIAL_STUB_TOKEN=dev-stub-token
# Default: OpenFreeMap (no API key). For MapTiler TR-region, use e.g.:
# NEXT_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Compose postgres credentials (must match DATABASE_URL)
POSTGRES_USER=citycomp
POSTGRES_PASSWORD=citycomp
POSTGRES_DB=citycomp
