PORT=8787
HOST=0.0.0.0

# Required — Neon (EU) or Fly Managed Postgres or local docker-compose.
# Local: docker compose up -d  →  postgres://city:city@127.0.0.1:5432/city_competition
DATABASE_URL=postgres://city:city@127.0.0.1:5432/city_competition

# Set true for Neon / most managed Postgres TLS endpoints.
# DATABASE_SSL=true

# Optional pool size (default 10)
# PG_POOL_MAX=10

# Required — Upstash (rediss://…) or local Redis. No Upstash cloud needed for local demo.
# Local: docker compose up -d  →  redis://127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379

# --- Auth ---
# Local mock (default): leave Supabase unset → phone OTP uses MOCK_OTP_CODE; Google/Apple are stubs.
MOCK_OTP_CODE=123456

# Live Supabase Auth (CC-19): set all three to enable JWT verify + user map.
# Phone OTP + Google + Apple run on the Expo client via @supabase/supabase-js;
# API accepts Bearer <supabase_access_token> on /v1/me and /v1/auth/supabase/session.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# OAuth provider IDs (also enable Google/Apple in Supabase Auth → Providers).
# GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID=

# Send SMS Hook (CC-20 Netgsm OTP).
# Point Supabase Auth → Hooks → Send SMS at POST {API}/v1/auth/hooks/send-sms
# SEND_SMS_HOOK_SECRETS=v1,whsec_...   # full secret string (commas OK); multi = a|b
# SMS_HOOK_DRY_RUN=true                # default: log OTP, no vendor call
# Live Netgsm (set dry-run false + credentials + approved başlık):
# SMS_HOOK_DRY_RUN=false
# NETGSM_USERCODE=312XXXXXXX           # Netgsm username
# NETGSM_PASSWORD=                     # Netgsm password
# NETGSM_MSGHEADER=NETGSM              # approved OTP sender / başlık (alias: NETGSM_SENDER)
# NETGSM_SANDBOX=true                  # optional — ext-sandbox.netgsm.com.tr
# NETGSM_APP_NAME=city-competition     # optional appName on OTP request
# NETGSM_OTP_TEMPLATE=City Competition code: {{otp}}  # Latin-only; {{otp}} replaced
