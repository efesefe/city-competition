# Full Fly secrets / health / match-day checklist: docs/fly-secrets-health-scale.md
# Deploy recipe (web + worker): docs/fly-deploy.md
PORT=8787
HOST=0.0.0.0

# Required — Neon (EU) or Fly Managed Postgres or local docker-compose.
# Local: docker compose up -d  →  postgres://city:city@127.0.0.1:5432/city_competition
# Fly: fly secrets set DATABASE_URL=… DATABASE_SSL=true
DATABASE_URL=postgres://city:city@127.0.0.1:5432/city_competition

# Set true for Neon / most managed Postgres TLS endpoints.
# DATABASE_SSL=true

# Optional pool size (default 10)
# PG_POOL_MAX=10

# Required — Upstash (rediss://…) or local Redis. No Upstash cloud needed for local demo.
# Local: docker compose up -d  →  redis://127.0.0.1:6379
# Fly: fly secrets set REDIS_URL=rediss://…
REDIS_URL=redis://127.0.0.1:6379

# Worker process (npm run start:worker / Fly process group `worker`)
# WORKER_GRANT_POLL_MS=60000
# WORKER_NOTIF_BRPOP_SEC=5
# WORKER_GRANT_LOCK_TTL_SEC=55

# --- Auth ---
# Local mock (default): leave Supabase unset → phone OTP uses MOCK_OTP_CODE; Google/Apple are stubs.
# Dev / staging only — omit in prod once Netgsm is live.
MOCK_OTP_CODE=123456

# Live Supabase Auth (CC-19): set all three to enable JWT verify + user map.
# Phone OTP + Google + Apple run on the Expo client via @supabase/supabase-js;
# API accepts Bearer <supabase_access_token> on /v1/me and /v1/auth/supabase/session.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# OAuth provider IDs (also enable Google/Apple in Supabase Auth → Providers).
# GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID=

# Send SMS Hook (CC-20 Netgsm OTP).
# Point Supabase Auth → Hooks → Send SMS at POST {API}/v1/auth/hooks/send-sms
# SEND_SMS_HOOK_SECRETS=v1,whsec_...   # full secret string (commas OK); multi = a|b
# SMS_HOOK_DRY_RUN=true                # default: log OTP, no vendor call
# Live Netgsm (set dry-run false + credentials + approved başlık):
# SMS_HOOK_DRY_RUN=false
# NETGSM_USERCODE=312XXXXXXX           # Netgsm username
# NETGSM_PASSWORD=                     # Netgsm password
# NETGSM_MSGHEADER=NETGSM              # approved OTP sender / başlık (alias: NETGSM_SENDER)
# NETGSM_SANDBOX=true                  # optional — ext-sandbox.netgsm.com.tr
# NETGSM_APP_NAME=city-competition     # optional appName on OTP request
# NETGSM_OTP_TEMPLATE=City Competition code: {{otp}}  # Latin-only; {{otp}} replaced

# Season 0 support ops — lost-SIM phone rebind (CC-22).
# Bearer token for GET /v1/support/users/lookup and POST /v1/support/phone/rebind (min 16 chars).
# SUPPORT_OPS_KEY=replace-with-long-random-ops-secret
# Optional: sync rebound phone onto linked Supabase Auth user (Admin API).
# SUPABASE_SERVICE_ROLE_KEY=

# --- RevenueCat / native IAP (CC-44 iOS + CC-45 Android) ---
# Webhook Authorization header value from RevenueCat → Integrations → Webhooks
# REVENUECAT_WEBHOOK_AUTHORIZATION=
# Optional secret API key (sk_…) for future server-side subscriber checks — never EXPO_PUBLIC_
# REVENUECAT_SECRET_API_KEY=
# RC_IOS_PRODUCT_ENERGY_SMALL=cc_ios_energy_small
# RC_IOS_PRODUCT_ENERGY_MEDIUM=cc_ios_energy_medium
# RC_IOS_PRODUCT_ENERGY_LARGE=cc_ios_energy_large
# RC_IOS_PRODUCT_SUB_MONTHLY=cc_ios_sub_monthly
# RC_ENTITLEMENT_SUB=monthly_sub
# Android Play Billing product IDs (must match Play Console + RevenueCat + Expo EXPO_PUBLIC_RC_ANDROID_*)
# RC_ANDROID_PRODUCT_PACK_SMALL=cc_android_pack_small_200
# RC_ANDROID_PRODUCT_PACK_MEDIUM=cc_android_pack_medium_600
# RC_ANDROID_PRODUCT_PACK_LARGE=cc_android_pack_large_1500
# RC_ANDROID_PRODUCT_SUB_MONTHLY=cc_android_sub_monthly
# Dev: simulate pack/sub grants without StoreKit (POST /v1/iap/stub)
# ALLOW_IAP_STUB=true
# --- iyzico web checkout (CC-46) ---
# Public base used for CF callback + mock checkout links (must be reachable by browser / iyzico).
# PUBLIC_API_BASE=http://127.0.0.1:8787
# Mock (default when keys absent): local Success/Fail 3DS page → grant energy in-process.
# IYZICO_MOCK=true
# Sandbox / live keys from merchant panel — never EXPO_PUBLIC_
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=
# IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# Subscription CF requires a pricing plan reference from the iyzico panel (not needed in mock).
# IYZICO_PRICING_PLAN_REF=
# Optional product id overrides (must match shop UI / economy SKUs)
# IYZICO_PRODUCT_PACK_SMALL=cc_web_pack_small_200
# IYZICO_PRODUCT_PACK_MEDIUM=cc_web_pack_medium_600
# IYZICO_PRODUCT_PACK_LARGE=cc_web_pack_large_1500
# IYZICO_PRODUCT_SUB_MONTHLY=cc_web_sub_monthly
