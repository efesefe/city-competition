EXPO_PUBLIC_API_URL=http://localhost:8787

# Live Supabase Auth (optional). Leave unset to use API mock OTP + OAuth stubs.
# Must match apps/api SUPABASE_URL / SUPABASE_ANON_KEY when API is in supabase mode.
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# RevenueCat public iOS SDK key (appl_…) — never the secret sk_ key
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=

# Must match apps/api RC_IOS_* / RC_ENTITLEMENT_SUB
# EXPO_PUBLIC_RC_IOS_PRODUCT_ENERGY_SMALL=cc_ios_energy_small
# EXPO_PUBLIC_RC_IOS_PRODUCT_ENERGY_MEDIUM=cc_ios_energy_medium
# EXPO_PUBLIC_RC_IOS_PRODUCT_ENERGY_LARGE=cc_ios_energy_large
# EXPO_PUBLIC_RC_IOS_PRODUCT_SUB_MONTHLY=cc_ios_sub_monthly
# EXPO_PUBLIC_RC_ENTITLEMENT_SUB=monthly_sub
